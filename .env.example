# Public site URL used for metadata, sitemap, and canonical links
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123

# Map provider: none | mapbox | google
NEXT_PUBLIC_MAP_PROVIDER=none
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# PostgreSQL (required when switching from demo JSON store to Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/seaps?schema=public

# S3-compatible object storage for listing uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_URL=

# Session / auth hardening for production
AUTH_SECRET=replace-with-long-random-string
