# Public site URL used for metadata, sitemap, and canonical links
# Production: https://www.vps1.store
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123

# Map provider: none (OpenStreetMap via Leaflet, free, no key) | mapbox | google
# OSM works out of the box when provider is none or Mapbox token is missing.
# For Mapbox later on Vercel: NEXT_PUBLIC_MAP_PROVIDER=mapbox + NEXT_PUBLIC_MAPBOX_TOKEN=...
NEXT_PUBLIC_MAP_PROVIDER=none
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# PostgreSQL (required when switching from demo JSON store to Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/seaps?schema=public

# S3-compatible object storage for listing uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_URL=

# Session / auth hardening for production
AUTH_SECRET=replace-with-long-random-string

# Optional Bearer token for cron/webhook Market Feed sync & import
# Authorization: Bearer <value> on /api/aggregations/sync and /api/aggregations/import
AGGREGATION_SYNC_SECRET=
# Vercel Cron also accepts CRON_SECRET as Bearer on /api/aggregations/sync
CRON_SECRET=
# Registry batch size per cron run (default 24, max 50)
AGGREGATION_BATCH_SIZE=
# Parallel HTTP fetches within a batch (default 4, max 8)
AGGREGATION_SYNC_CONCURRENCY=
# Stop scheduling new sources after this many ms (default 52000)
AGGREGATION_SYNC_MAX_MS=
