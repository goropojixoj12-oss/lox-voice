# Public site URL used for metadata, sitemap, and canonical links
# Production: https://www.seaps.asia
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123

# Admin safety (production: leave unset / false)
# SEAPS_ENABLE_SITE_CHANGE_REQUESTS=false
# NEXT_PUBLIC_SEAPS_ENABLE_SITE_CHANGE_REQUESTS=false
# SEAPS_ENABLE_ADMIN_AGGREGATION_CONTROL=false

# Map provider: none (OpenStreetMap via Leaflet, free, no key) | mapbox | google
# OSM works out of the box when provider is none or Mapbox token is missing.
# For Mapbox later on Vercel: NEXT_PUBLIC_MAP_PROVIDER=mapbox + NEXT_PUBLIC_MAPBOX_TOKEN=...
NEXT_PUBLIC_MAP_PROVIDER=none
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Footer Google Maps iframe (Share → Embed a map → copy src URL)
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# PostgreSQL (required when switching from demo JSON store to Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/seaps?schema=public

# Market Feed persistence on Vercel (required for listings to accumulate in production)
# Prefer Redis from Vercel Marketplace / Upstash integration:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# (Upstash-only names are aliased automatically: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)
# Or Vercel Blob store (read-write token and/or OIDC on Vercel):
# BLOB_READ_WRITE_TOKEN=
# VERCEL_BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=          # with VERCEL=1 / VERCEL_OIDC_TOKEN, SDK uses OIDC without token
# BLOB_WEBHOOK_PUBLIC_KEY=

# S3-compatible object storage for listing uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_URL=

# Required for signed en_session cookies (HMAC). Without a real secret, login fails.
# Generate: openssl rand -base64 48
# Must match Production on Vercel (Settings → Environment Variables → Redeploy).
AUTH_SECRET=replace-with-long-random-string

# Optional Bearer token for cron/webhook Market Feed sync & import
# Authorization: Bearer <value> on /api/aggregations/sync and /api/aggregations/import
AGGREGATION_SYNC_SECRET=
# Vercel Cron also accepts CRON_SECRET as Bearer on /api/aggregations/sync
CRON_SECRET=
# Bearer for cloud agent: GET /api/admin/site-requests/pull, PATCH .../site-requests/[id]
# Cursor Automation webhook when admin clicks Send (or cron picks queue):
# SITE_AGENT_WEBHOOK_URL=https://api2.cursor.sh/automations/webhook/...
# SITE_AGENT_WEBHOOK_BEARER=crsr_...  (Generate auth header in Automations UI)
SITE_AGENT_SECRET=
# Same value as SITE_AGENT_SECRET so Vercel Cron can call /api/cron/site-agent
# CRON_SECRET=
# Outbound SMTP for public site forms (Hostinger: smtp.hostinger.com, port 465, SSL)
# From internal@seaps.asia → ceo@seaps.asia (override with SMTP_FROM / SMTP_TO)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=internal@seaps.asia
SMTP_PASS=
SMTP_FROM=internal@seaps.asia
SMTP_TO=ceo@seaps.asia

# Registry batch size per cron run (default 24, max 50)
AGGREGATION_BATCH_SIZE=
# Parallel HTTP fetches within a batch (default 4, max 8)
AGGREGATION_SYNC_CONCURRENCY=
# Stop scheduling new sources after this many ms (default 52000)
AGGREGATION_SYNC_MAX_MS=
