# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# demo runtime persistence
.data/

# local scratch (audit scripts, browser profiles, dumps) — never committed,
# and tailwind's automatic source detection must not walk into it
/tmp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
backups/
.brv/
modelcontextprotocol-server-github-2025.4.8.tgz
